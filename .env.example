# Copy this file to .env and fill values locally.
# Never commit real secrets.

MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?appName=neurotrap
GROQ_API_KEY=your_groq_api_key_here
NEUROTRAP_SENTRY_DSN=
NEUROTRAP_SENTRY_TRACES_SAMPLE_RATE=0.2
NEUROTRAP_SENTRY_PROFILES_SAMPLE_RATE=0.2

# Public feed privacy controls (safe defaults)
NEUROTRAP_PUBLIC_INCLUDE_REPLAY=false
NEUROTRAP_PUBLIC_INCLUDE_EVENT_DETAILS=false

# Optional Telegram alerts
NEUROTRAP_TELEGRAM_TOKEN=
NEUROTRAP_TELEGRAM_CHAT=
